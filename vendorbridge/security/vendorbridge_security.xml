<?xml version="1.0" encoding="utf-8"?>
<<odoo>
    <!-- Groups -->
    <record id="group_procurement_manager" model="res.groups">
        <field name="name">Procurement Manager</field>
        <field name="category_id" ref="base.module_category_operations_purchase"/>
    </record>

    <record id="group_procurement_officer" model="res.groups">
        <field name="name">Procurement Officer</field>
        <field name="category_id" ref="base.module_category_operations_purchase"/>
    </record>

    <record id="group_vendor_portal" model="res.groups">
        <field name="name">Vendor Portal</field>
        <field name="category_id" ref="base.module_category_user_type"/>
    </record>

    <!-- Record Rules -->
    <record id="rule_rfq_vendor" model="ir.rule">
        <field name="name">Vendor: Only Own RFQs</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[('vendor_ids.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_vendor_portal'))]"/>
    </record>

    <record id="rule_quotation_vendor" model="ir.rule">
        <field name="name">Vendor: Only Own Quotations</field>
        <field name="model_id" ref="model_vendorbridge_quotation"/>
        <field name="domain_force">[('vendor_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_vendor_portal'))]"/>
    </record>

    <record id="rule_rfq_officer" model="ir.rule">
        <field name="name">Officer: Only Own RFQs</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_procurement_officer'))]"/>
    </record>
</odoo>