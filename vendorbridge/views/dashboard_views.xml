<?xml version="1.0" encoding="utf-8"?>
<<odoo>
    <data>
        <!-- Dashboard Action -->
        <record id="action_dashboard" model="ir.actions.client">
            <field name="name">Dashboard</field>
            <field name="tag">vendorbridge_dashboard</field>
        </record>

        <!-- Dashboard Template -->
        <template id="assets_dashboard" inherit_id="web.assets_backend">
            <xpath expr="." position="inside">
                <script type="text/javascript" src="/vendorbridge/static/src/js/dashboard.js"/>
                <link rel="stylesheet" type="text/css" href="/vendorbridge/static/src/css/dashboard.css"/>
            </xpath>
        </template>
    </data>
</odoo>