<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Dashboard Action -->
        <record id="action_dashboard" model="ir.actions.client">
            <field name="name">Dashboard</field>
            <field name="tag">vendorbridge_dashboard</field>
        </record>

        <!-- Dashboard Assets -->
        <record id="assets_dashboard_js" model="ir.asset">
            <field name="name">vendorbridge.assets_dashboard_js</field>
            <field name="bundle">web.assets_backend</field>
            <field name="path">/vendorbridge/static/src/js/dashboard.js</field>
        </record>
        <record id="assets_dashboard_css" model="ir.asset">
            <field name="name">vendorbridge.assets_dashboard_css</field>
            <field name="bundle">web.assets_backend</field>
            <field name="path">/vendorbridge/static/src/css/dashboard.css</field>
        </record>
    </data>
</odoo>
