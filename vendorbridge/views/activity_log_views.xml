<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_activity_log_tree" model="ir.ui.view">
            <field name="name">vendorbridge.activity_log.tree</field>
            <field name="model">vendorbridge.activity_log</field>
            <field name="arch" type="xml">
                <tree string="Activity Logs">
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="model_name"/>
                    <field name="action_type"/>
                    <field name="create_date"/>
                </tree>
            </field>
        </record>

        <record id="action_activity_log_list" model="ir.actions.act_window">
            <field name="name">Activity Logs</field>
            <field name="res_model">vendorbridge.activity_log</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
